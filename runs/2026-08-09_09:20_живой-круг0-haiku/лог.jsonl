{"н": 14, "время": "2026-08-09T06:21:35+00:00", "секунд_от_старта": 99.0, "тип_события": "ход", "круг": 0, "режим": "КРУГ_НОЛЬ", "говорящий": "Ханна", "порядок_в_круге": 3, "видимость": "всем", "текст": "Ханна жует медленно, слушает. Пёс лежит у её ног. Она смотрит на Ансельма, когда он говорит про правду. «Молчание — не честность», — говорит коротко, откусывает хлеб. «Крысы оставляют выход. Я тоже.»", "метки": [], "провайдер": "claude", "модель": "haiku", "латентность_мс": 41861, "токены": {"input_tokens": 10, "cache_creation_input_tokens": 5538, "cache_read_input_tokens": 22100, "output_tokens": 4069, "server_tool_use": {"web_search_requests": 0, "web_fetch_requests": 0}, "service_tier": "standard", "cache_creation": {"ephemeral_1h_input_tokens": 5538, "ephemeral_5m_input_tokens": 0}, "inference_geo": "not_available", "iterations": [{"input_tokens": 10, "output_tokens": 4069, "cache_read_input_tokens": 22100, "cache_creation_input_tokens": 5538, "cache_creation": {"ephemeral_5m_input_tokens": 0, "ephemeral_1h_input_tokens": 5538}, "type": "message"}], "speed": "standard"}, "стоимость": 0.035117999999999996}
