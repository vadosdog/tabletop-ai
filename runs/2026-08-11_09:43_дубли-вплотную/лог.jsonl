{"н": 15, "время": "2026-08-11T06:44:22+00:00", "секунд_от_старта": 25.0, "тип_события": "ход", "контекст_символов": 2049, "круг": 0, "режим": "КРУГ_НОЛЬ", "говорящий": "Ханна", "порядок_в_круге": 3, "видимость": "всем", "текст": "Ханна не поднимает глаз от миски, гладит Пса по загривку — тот лежит у её ног, уши торчком. «В Кальтенбрюке крысы в амбаре старосты были с локоть, не меньше — потому и наняли, сама я оттуда родом, третий год промышляю». Она недоговаривает: не так уж и родом, просто прожила там достаточно, чтоб все считали своей. На Лизель не смотрит, спрашивает в сторону очага: «Бумаги покажешь — а скажи, откуда шла, когда нас на дороге догнала? Пешком в такую погоду по доброй воле не ходят».", "метки": [], "провайдер": "claude", "модель": "claude-sonnet-5", "латентность_мс": 6886, "токены": {"input_tokens": 2, "cache_creation_input_tokens": 1790, "cache_read_input_tokens": 32872, "output_tokens": 219, "server_tool_use": {"web_search_requests": 0, "web_fetch_requests": 0}, "service_tier": "standard", "cache_creation": {"ephemeral_1h_input_tokens": 1790, "ephemeral_5m_input_tokens": 0}, "inference_geo": "not_available", "iterations": [{"input_tokens": 2, "output_tokens": 219, "cache_read_input_tokens": 32872, "cache_creation_input_tokens": 1790, "cache_creation": {"ephemeral_5m_input_tokens": 0, "ephemeral_1h_input_tokens": 1790}, "type": "message"}], "speed": "standard"}, "стоимость": 0.0254686}
