{"н": 11, "время": "2026-08-11T06:44:15+00:00", "секунд_от_старта": 18.1, "тип_события": "ход", "контекст_символов": 1631, "круг": 0, "режим": "КРУГ_НОЛЬ", "говорящий": "Ансельм", "порядок_в_круге": 2, "видимость": "всем", "текст": "Брат Ансельм ставит кружку на стол резче, чем нужно. «Служил, три года, в храме под Нульном — молот на поясе не для украшения ношу». Взгляд задерживается на огне чуть дольше, чем требует ответ. «Ушёл сам, дороги вести душеспасительнее стен, вот и весь сказ». Он поворачивается к Лизель: «А у тебя бумаги, говоришь, в порядке — так покажи их при свете, здесь и сейчас, чего им в сумке пылиться?»", "метки": [], "провайдер": "claude", "модель": "claude-sonnet-5", "латентность_мс": 5454, "токены": {"input_tokens": 2, "cache_creation_input_tokens": 1581, "cache_read_input_tokens": 32867, "output_tokens": 185, "server_tool_use": {"web_search_requests": 0, "web_fetch_requests": 0}, "service_tier": "standard", "cache_creation": {"ephemeral_1h_input_tokens": 1581, "ephemeral_5m_input_tokens": 0}, "inference_geo": "not_available", "iterations": [{"input_tokens": 2, "output_tokens": 185, "cache_read_input_tokens": 32867, "cache_creation_input_tokens": 1581, "cache_creation": {"ephemeral_5m_input_tokens": 0, "ephemeral_1h_input_tokens": 1581}, "type": "message"}], "speed": "standard"}, "стоимость": 0.0235381}
